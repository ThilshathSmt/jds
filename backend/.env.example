# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=jeslan_driving_school

# Secret used to sign login sessions. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change_this_secret

# Folder for uploaded application documents (default: backend/uploads)
# UPLOAD_DIR=uploads

# Frontend origin allowed to call the API with credentials
CLIENT_URL=http://localhost:5173

# Links in e-mails (password reset, e-mail verification) point to CLIENT_URL above, so set
# it to the public address of the frontend in production.

# EmailJS (https://dashboard.emailjs.com): sends the password reset and e-mail verification
# e-mails from the server. In EmailJS > Account > Security, enable "Allow EmailJS API for
# non-browser applications". The private key is a secret: never put it in the frontend.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_RESET_TEMPLATE_ID=
# Optional: a separate template for e-mail change verification (default: the reset template)
EMAILJS_VERIFY_EMAIL_TEMPLATE_ID=

# First admin account, created by `npm run seed:admin`
ADMIN_DRIVING_SCHOOL_ID=JDS_admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@jeslan.lk
ADMIN_PASSWORD=change_this_password
