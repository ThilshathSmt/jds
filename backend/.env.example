# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=jeslan_driving_school

# Secret used to sign login sessions. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change_this_secret

# Folder for uploaded application documents (default: backend/uploads)
# UPLOAD_DIR=uploads

# Frontend origin allowed to call the API with credentials
CLIENT_URL=http://localhost:5173

# First admin account, created by `npm run seed:admin`
ADMIN_DRIVING_SCHOOL_ID=JDS_admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@jeslan.lk
ADMIN_PASSWORD=change_this_password
